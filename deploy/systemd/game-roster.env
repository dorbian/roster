# Runtime configuration for roster.thebigtree.life on 192.168.0.203.
# Installed to: /opt/groster/config/game-roster.env

ROSTER_IMAGE=ghcr.io/dorbian/roster:latest
ROSTER_CONTAINER_NAME=game-roster
ROSTER_HOSTNAME=roster.thebigtree.life
ROSTER_DATA_DIR=/data
ROSTER_PORT=8500
PODMAN_NETWORK=honsefarm
SESSION_TTL_SECONDS=1209600

# Host paths. Keep all roster-owned state under /opt/groster.
GROSTER_ROOT=/opt/groster
GROSTER_SOURCE_DIR=/opt/groster/source
GROSTER_DATA_DIR=/opt/groster/data
GROSTER_CONFIG_DIR=/opt/groster/config
